#totalsbar {
    dock: top;
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
}

.section {
    margin: 1 0 0 1;
    text-style: bold;
    color: $accent;
}

#running {
    height: auto;
    max-height: 10;
    margin: 0 1;
}

#recent {
    height: 1fr;
    margin: 0 1;
}

#quickstart {
    height: 3;
    margin: 1 1 0 1;
}

#qs_desc {
    width: 1fr;
}

#qs_cat {
    width: 18;
    margin: 0 1;
}

#logbar {
    height: 3;
    margin: 0 1;
    align: left middle;
}

#logbar Button {
    min-width: 4;
    margin: 0 1 0 0;
}

#month_label {
    width: auto;
    content-align: center middle;
    text-style: bold;
}

#filter_cat {
    width: 22;
    margin: 0 1;
}

#search {
    width: 1fr;
}

#logtable {
    height: 1fr;
    margin: 0 1;
}

#log_total {
    height: 1;
    padding: 0 1;
    background: $panel;
    text-style: bold;
}

#logactions, #invactions {
    height: 3;
    margin: 0 1;
    align: left middle;
}

#logactions Button, #invactions Button {
    margin: 0 1 0 0;
}

#invbar {
    height: 3;
    margin: 0 1;
    align: left middle;
}

#invbar Button {
    min-width: 4;
    margin: 0 1 0 0;
}

#inv_month_label {
    width: auto;
    content-align: center middle;
    text-style: bold;
}

#inv_client {
    width: 20;
    margin: 0 1;
}

#inv_next_num {
    width: auto;
    content-align: left middle;
}

#invtable {
    height: 1fr;
    margin: 0 1;
}

#inv_delta {
    height: 1;
    padding: 0 1;
    background: $panel;
    text-style: bold;
}

#repbar {
    height: 3;
    margin: 0 1;
    align: left middle;
}

#repbar Button {
    min-width: 4;
    margin: 0 1 0 0;
}

#rep_month_label {
    width: auto;
    content-align: center middle;
    text-style: bold;
}

#rep_summary {
    width: 1fr;
    content-align: left middle;
}

#rep_cat {
    height: auto;
    max-height: 14;
    margin: 0 1;
}

#rep_week {
    height: 1fr;
    margin: 0 1;
}

/* Help overlay */
HelpScreen {
    align: center middle;
}

#help {
    width: 78;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $surface;
    border: thick $accent;
}

#help-foot {
    margin-top: 1;
    content-align: center middle;
}

/* Modal forms */
#form {
    width: 72;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: thick $accent;
}

#form Input {
    margin-bottom: 1;
}

#form Select {
    margin-bottom: 1;
}

/* Confirm-stop modal */
ConfirmStop, Confirm, EntryForm, LineItemForm {
    align: center middle;
}

#modal {
    width: 60;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: thick $accent;
}

#modal-title {
    text-style: bold;
    color: $accent;
}

#modal-notes {
    margin: 1 0;
    color: $text-muted;
}

#modal-buttons {
    height: auto;
    align: right middle;
    margin-top: 1;
}

#modal-buttons Button {
    margin-left: 2;
}
